{
  "name": "deco-gestion",
  "productName": "Déco Gestion",
  "version": "2.3.0",
  "description": "Permet de produire plus facilement l'imposition des visuels sur les plaques à imprimer.",
  "scripts": {
    "start": "set NODE_ENV=production&& node ./server/server.js -e js,css,html",
    "server": "docker compose up redis -d && set NODE_ENV=development&& nodemon ./server/server.js -e js,css,html --ignore server/public/",
    "format": "prettier-eslint \"./server/**/*.js\" --write && prettier-eslint \"./client/src/**/*.{js,jsx}\" --write",
    "client": "set NODE_ENV=development&& cd client && npm run dev",
    "build": "set NODE_ENV=production&& cd client && npm run build",
    "test": "mocha \"test/**/*.test.js\" --timeout 10000 --exit",
    "test:unit": "mocha \"test/unit/**/*.test.js\" --timeout 10000 --exit",
    "test:integration": "mocha \"test/integration/**/*.test.js\" --timeout 60000 --exit",
    "test:coverage": "nyc --reporter=text --reporter=html --reporter=lcov mocha \"test/**/*.test.js\" --timeout 10000 --exit",
    "test:ci": "nyc --reporter=text --reporter=lcov mocha \"test/unit/**/*.test.js\" --ignore \"test/unit/queueService.test.js\" --timeout 10000 --exit",
    "lint": "eslint \"server/src/**/*.js\""
  },
  "keywords": [],
  "author": "Weedomeker",
  "license": "ISC",
  "bugs": "https://github.com/Weedomeker/decoGestion/issues",
  "repository": {
    "type": "git",
    "url": "https://github.com/Weedomeker/decoGestion.git"
  },
  "dependencies": {
    "@bull-board/api": "^8.0.1",
    "@bull-board/express": "^8.0.1",
    "@types/fs-extra": "^11.0.1",
    "bullmq": "^5.79.0",
    "chalk": "^4.1.2",
    "cli-progress": "^3.12.0",
    "compression": "^1.8.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "gm": "^1.25.1",
    "image-size": "^1.2.1",
    "ini": "^5.0.0",
    "ioredis": "^5.11.1",
    "jimp": "^0.22.12",
    "makerjs": "^0.18.1",
    "mongoose": "^8.22.1",
    "morgan": "^1.10.0",
    "node-fetch": "^2.7.0",
    "odbc": "^2.5.0",
    "p-limit": "^3.1.0",
    "path": "^0.12.7",
    "pdf-lib": "^1.17.1",
    "pdf-poppler": "^0.2.1",
    "pdf2pic": "^3.1.4",
    "pdfkit": "^0.15.1",
    "pdftopic": "^0.2.0",
    "piscina": "^5.2.0",
    "serve-index": "^1.9.1",
    "uuid": "^11.0.3",
    "winston": "^3.18.3",
    "winston-daily-rotate-file": "^5.0.0",
    "ws": "^8.17.0",
    "xml2js": "^0.6.2"
  },
  "devDependencies": {
    "chai": "^5.1.2",
    "dotenv": "^16.4.5",
    "eslint": "^8.52.0",
    "eslint-config-prettier": "^10.1.8",
    "isdev": "^1.0.1",
    "mocha": "^11.1.0",
    "mongodb-memory-server": "^9.5.0",
    "nyc": "^17.1.0",
    "prettier": "^3.1.0",
    "prettier-eslint": "^16.1.2",
    "prettier-eslint-cli": "^8.0.1",
    "sinon": "^17.0.1"
  },
  "nyc": {
    "exclude": [
      "test/**",
      "server/public/**"
    ],
    "branches": 50,
    "lines": 50
  }
}
