# Copier en `.env` (racine) et renseigner les valeurs. NE JAMAIS committer `.env`.
# En production, préférer des variables d'environnement du runtime plutôt qu'un fichier.

# --- Serveur ---
HOST=localhost
PORT=8000

# Fenêtre (en jours) du backfill automatique prix/date de livraison au démarrage. Défaut : 2.
PRIX_BACKFILL_LOOKBACK_DAYS=2

# --- PostgreSQL ODBC (ERP Gamesys) ---
ODBC_DSN=PostgreSQL35W
DB_USER=<utilisateur_odbc>
DB_PASSWORD=<mot_de_passe_odbc>
# Alternative si le DSN Windows n'est pas configuré :
# ODBC_CONNECTION_STRING=Driver={PostgreSQL Unicode(x64)};Server=<hote>;Port=<port>;Database=<base>;Uid=<user>;Pwd=<password>;

# --- MongoDB ---
# Inclure le nom de la base dans l'URI ; utiliser un compte/identifiant DISTINCT par environnement
# (le compte prod ne doit pas pouvoir lire la base de dev et inversement).
MONGO_URL=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/

# --- Partages réseau (aussi modifiables via la modale Config de l'app) ---
LINK_DECO=\\SERVEUR\partage\...
LINK_DECO_RACCORDABLES=\\SERVEUR\partage\...
LINK_DECO_SUR_MESURE=\\SERVEUR\partage\...
LINK_DECO_ECOM=\\SERVEUR\partage\...
LINK_TAURO=\\SERVEUR\HotFolderRoot

# --- Redis (BullMQ) ---
REDIS_URL=redis://localhost:6379
