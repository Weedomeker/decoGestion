# Copier en `client/.env` et renseigner les valeurs. NE JAMAIS committer `client/.env`.
# Toutes les variables VITE_* sont exposées dans le bundle client — n'y mettre aucun secret.

VITE_PROTOCOL=http
VITE_HOST=localhost
VITE_PORT=8000

# Clé Google Maps — À RESTREINDRE par referrer HTTP dans la console GCP (sinon exploitable).
VITE_API_GOOGLE=<cle_google_maps_restreinte_par_referrer>
